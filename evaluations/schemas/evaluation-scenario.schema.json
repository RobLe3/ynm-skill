{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynm:schemas:evaluation-scenario.schema.json",
  "type": "object",
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"const": "ynm-evaluation-scenarios.v1"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "kind", "prompt", "expected_behavior"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:TRIG|YNM-EVAL|YNM-140-HOLD)-[0-9]{3}$"},
          "kind": {"enum": ["TRIGGER", "BENCHMARK"]},
          "prompt": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "expected_behavior": {"type": "string", "minLength": 1},
          "expected_level": {"enum": ["YNM-0", "YNM-1", "YNM-2", "YNM-3"]},
          "expected_retrieval": {"enum": ["DIRECT", "AST", "DIFF", "COVERAGE", "SEMANTIC", "NONE"]},
          "expected_activation": {"type": "boolean"},
          "ground_truth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "material_propositions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "required_maybe": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "forbidden_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "TRIGGER"}}}, "then": {"required": ["expected_activation"]}},
          {"if": {"properties": {"kind": {"const": "BENCHMARK"}}}, "then": {"required": ["fixture", "ground_truth"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
