{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynm:schemas:finding.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "proposition",
    "source_loop",
    "scope",
    "observation",
    "evidence",
    "interpretation",
    "proposed_disposition",
    "disposition",
    "created_at",
    "updated_at",
    "history",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "proposition": {
      "type": "string",
      "minLength": 1
    },
    "source_loop": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": [
        "string",
        "object"
      ]
    },
    "observation": {
      "type": [
        "string",
        "array"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "proposed_disposition": {
      "$ref": "ynm-defs.schema.json#/$defs/disposition"
    },
    "disposition": {
      "$ref": "ynm-defs.schema.json#/$defs/disposition"
    },
    "disposition_reason": {
      "type": "string"
    },
    "assessment_reference": {
      "type": "string"
    },
    "action_recommendation": {
      "type": "string"
    },
    "authorization_status": {
      "$ref": "ynm-defs.schema.json#/$defs/authorizationStatus"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "$ref": "ynm-defs.schema.json#/$defs/findingStatus"
    },
    "failure_origin": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "related_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revisit_conditions": {
      "type": [
        "string",
        "array"
      ]
    },
    "reopen_reason": {
      "type": "string"
    },
    "resolution_evidence": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "string"
    },
    "confidence": {
      "type": [
        "string",
        "number"
      ]
    },
    "maturity_impact": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "MAYBE"
          }
        }
      },
      "then": {
        "required": [
          "disposition_reason"
        ]
      }
    }
  ],
  "additionalProperties": false
}
