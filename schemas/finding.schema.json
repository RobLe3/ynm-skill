{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ynm.example/schemas/finding.schema.json",
  "type": "object",
  "required": ["id", "title", "proposition", "source_loop", "scope", "observation", "evidence", "interpretation", "proposed_disposition", "disposition", "created_at", "updated_at", "history", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "proposition": {"type": "string", "minLength": 1},
    "source_loop": {"type": "string", "minLength": 1},
    "scope": {"type": ["string", "object"]},
    "observation": {"type": ["string", "array"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "interpretation": {"type": "string", "minLength": 1},
    "proposed_disposition": {"$ref": "ynm-defs.schema.json#/$defs/disposition"},
    "disposition": {"$ref": "ynm-defs.schema.json#/$defs/disposition"},
    "disposition_reason": {"type": "string"},
    "authorization_status": {"$ref": "ynm-defs.schema.json#/$defs/authorizationStatus"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "history": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"$ref": "ynm-defs.schema.json#/$defs/findingStatus"}
  },
  "allOf": [{"if": {"properties": {"disposition": {"const": "MAYBE"}}}, "then": {"required": ["disposition_reason"]}}],
  "additionalProperties": true
}
