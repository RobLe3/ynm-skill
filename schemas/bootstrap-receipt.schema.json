{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynm:schemas:bootstrap-receipt.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "bootstrap_id",
    "project",
    "mode",
    "execution_status",
    "discovered_artifacts",
    "reused_artifacts",
    "created_artifacts",
    "updated_artifacts",
    "untouched_conflicting_artifacts",
    "ynm_state_location",
    "persistence_mode",
    "mutation_authorization",
    "unresolved_questions",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "ynm-bootstrap-receipt.v1"
    },
    "bootstrap_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "DISCOVER",
        "INITIALIZE"
      ]
    },
    "execution_status": {
      "$ref": "ynm-defs.schema.json#/$defs/executionStatus"
    },
    "discovered_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reused_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "untouched_conflicting_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ynm_state_location": {
      "type": "string",
      "minLength": 1
    },
    "persistence_mode": {
      "enum": [
        "STATELESS",
        "PERSISTENT"
      ]
    },
    "mutation_authorization": {
      "$ref": "ynm-defs.schema.json#/$defs/authorizationStatus"
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
